{
  "name": "member-community-backend",
  "version": "1.0.0",
  "private": true,
  "main": "src/main/server.js",
  "scripts": {
    "dev": "node --watch src/main/server.js",
    "start": "node src/main/server.js",
    "migrate:up": "node-pg-migrate up --migration-file-language sql --migrations-dir src/infrastructure/database/postgres/migrations",
    "migrate:down": "node-pg-migrate down --migration-file-language sql --migrations-dir src/infrastructure/database/postgres/migrations",
    "seed:admin": "node src/infrastructure/database/postgres/seeds/seedAdmin.js",
    "seed:demo": "node src/infrastructure/database/postgres/seeds/seedDemo.js",
    "seed:tech": "node src/infrastructure/database/postgres/seeds/seedTech.js",
    "seed:avatars": "node src/infrastructure/database/postgres/seeds/seedAvatars.js",
    "test": "jest --runInBand --coverage",
    "test:unit": "jest tests/unit --runInBand",
    "test:e2e": "jest tests/e2e --runInBand",
    "test:integration": "jest tests/integration --runInBand --detectOpenHandles",
    "lint": "eslint src tests"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "nodemailer": "^9.0.6",
    "pg": "^8.16.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "eslint": "^9.34.0",
    "jest": "^30.1.3",
    "node-pg-migrate": "^8.0.3",
    "supertest": "^7.1.4"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/application/**/*.js",
      "src/domain/**/*.js"
    ]
  }
}
